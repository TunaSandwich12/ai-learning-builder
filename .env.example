# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project settings (Project Settings -> API). The anon key is safe to expose to the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = /api/generate returns a saved sample instead of calling the AI.
FAKE_MODE=true

# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
